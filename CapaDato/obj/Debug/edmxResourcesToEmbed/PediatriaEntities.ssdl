[CargarConsultaV].[IDMedico] AS [IDMedico], 
[CargarConsultaV].[Activo] AS [Activo], 
[CargarConsultaV].[IdSomatometria] AS [IdSomatometria], 
[CargarConsultaV].[IDConsulta] AS [IDConsulta], 
[CargarConsultaV].[Peso] AS [Peso], 
