  <EntityContainer Name="ConsultorioPediatricoBDModelStoreContainer">
    <EntitySet Name="AntecedentePersonalV" EntityType="Self.AntecedentePersonalV" store:Type="Views" store:Schema="dbo">
      <DefiningQuery>SELECT 
[AntecedentePersonalV].[Id] AS [Id], 
[AntecedentePersonalV].[IDPaciente] AS [IDPaciente], 
[AntecedentePersonalV].[Padecimiento] AS [Padecimiento], 
[AntecedentePersonalV].[EnfermedadCronica] AS [EnfermedadCronica], 
[AntecedentePersonalV].[Alergias] AS [Alergias], 
[AntecedentePersonalV].[Transfusion] AS [Transfusion], 
[AntecedentePersonalV].[Hospitalizacion] AS [Hospitalizacion], 
[AntecedentePersonalV].[TipoVivienda] AS [TipoVivienda], 
[AntecedentePersonalV].[HabitoHigiene] AS [HabitoHigiene], 
[AntecedentePersonalV].[HabitoAlimentacion] AS [HabitoAlimentacion], 
[AntecedentePersonalV].[DesarrolloSocial] AS [DesarrolloSocial], 
[AntecedentePersonalV].[Activo] AS [Activo], 
[AntecedentePersonalV].[Cirugias] AS [Cirugias]
FROM [dbo].[AntecedentePersonalV] AS [AntecedentePersonalV]</DefiningQuery>
    </EntitySet>
    <EntitySet Name="CargarConsultaV" EntityType="Self.CargarConsultaV" store:Type="Views" store:Schema="dbo">
      <DefiningQuery>SELECT 
